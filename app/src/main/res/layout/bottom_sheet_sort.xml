<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottomSheetContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_top_corners"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:id="@+id/textView34"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sort By:"
            android:textColor="@color/blue"
            android:fontFamily="@font/montserrat_extrabold"
            android:textSize="20sp"
            android:layout_marginBottom="12dp" />

        <!-- Item Type Section -->
        <TextView
            android:id="@+id/textView35"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Item Type"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/radioreportTypeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center">

            <RadioButton
                android:id="@+id/radioAll"
                style="@style/CustomRadioButton"
                android:text="All" />

            <RadioButton
                android:id="@+id/radioLost"
                style="@style/CustomRadioButton"
                android:text="Lost" />

            <RadioButton
                android:id="@+id/radioFound"
                style="@style/CustomRadioButton"
                android:text="Found" />
        </LinearLayout>

        <!-- Category Section -->
        <TextView
            android:id="@+id/textView31"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <!-- Category Radio Buttons -->
        <LinearLayout
            android:id="@+id/constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="5dp">

                <RadioButton
                    android:id="@+id/radioAllcategory"
                    style="@style/CustomRadioButton"
                    android:text="All" />

                <RadioButton
                    android:id="@+id/radioGadget"
                    style="@style/CustomRadioButton"
                    android:text="Gadgets" />

                <RadioButton
                    android:id="@+id/radioAccessories"
                    style="@style/CustomRadioButton"
                    android:text="Accessories" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="5dp">

                <RadioButton
                    android:id="@+id/radioPersonal"
                    style="@style/CustomRadioButton"
                    android:text="Personal Belongings" />

                <RadioButton
                    android:id="@+id/radioDrinkware"
                    style="@style/CustomRadioButton"
                    android:text="Drinkware" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="5dp">

                <RadioButton
                    android:id="@+id/radioSchoolsupplies"
                    style="@style/CustomRadioButton"
                    android:text="School Supplies" />

                <RadioButton
                    android:id="@+id/radioClothing"
                    style="@style/CustomRadioButton"
                    android:text="Clothing" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioBag"
                    style="@style/CustomRadioButton"
                    android:text="Bags" />

                <RadioButton
                    android:id="@+id/radioOthers"
                    style="@style/CustomRadioButton"
                    android:text="Others" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/textViewLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Location"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:id="@+id/radioLocationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="5dp">

                <RadioButton
                    android:id="@+id/radioAlllocation"
                    style="@style/CustomRadioButton"
                    android:text="All" />

                <RadioButton
                    android:id="@+id/radioOval"
                    style="@style/CustomRadioButton"
                    android:text="Umak Oval" />

                <RadioButton
                    android:id="@+id/radioHPSB"
                    style="@style/CustomRadioButton"
                    android:text="HPSB" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="5dp">

                <RadioButton
                    android:id="@+id/radioAdmin"
                    style="@style/CustomRadioButton"
                    android:text="Admin Building" />
                <RadioButton
                    android:id="@+id/radioLibrary"
                    style="@style/CustomRadioButton"
                    android:text="Library" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="5dp">

                <RadioButton
                    android:id="@+id/radioAcad1"
                    style="@style/CustomRadioButton"
                    android:text="Academic Building 1" />

                <RadioButton
                    android:id="@+id/radioCafeteria"
                    style="@style/CustomRadioButton"
                    android:text="Cafeteria" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioAcad2"
                    style="@style/CustomRadioButton"
                    android:text="Academic Building 2" />

            </LinearLayout>
        </LinearLayout>

        <!-- Apply Button -->
        <Button
            android:id="@+id/applyBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/blue"
            android:paddingStart="40dp"
            android:paddingEnd="40dp" />

    </LinearLayout>
</ScrollView>

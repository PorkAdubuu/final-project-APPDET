<resources>
    <style name="FloatingActivityTheme" parent="Theme.AppCompat.Dialog">
        <item name="android:windowIsTranslucent">true</item> <!-- Make the background translucent -->
        <item name="android:backgroundDimEnabled">true</item> <!-- Dim the background -->
        <item name="android:windowBackground">@android:color/transparent</item> <!-- Transparent window background -->
        <item name="android:windowFrame">@android:color/transparent</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerRadius" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="FullScreenDialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowIsFloating">true</item> <!-- must be true -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
    <style name="CustomDialogTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="shapeAppearanceOverlay">@style/RoundedDialog</item>
    </style>

    <style name="RoundedDialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="CustomRadioButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/radiobutton_selector</item>
        <item name="android:button">@null</item>
        <item name="android:fontFamily">@font/montserrat_extrabold</item>
        <item name="android:textColor">@color/radio_text_color</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>




</resources>
